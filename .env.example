APP_HOST=127.0.0.1
APP_PORT=8000

# --- Routing ---
ROUTER_URL=https://router.project-osrm.org
PUBLIC_ROUTER_FALLBACK=true
ROUTE_TIMEOUT_SECONDS=2.0
ROUTE_CACHE_SIZE=4096
TRAFFIC_FACTOR=1.0

# --- Persistence & event bus ---
# SQLite is fine for a single-instance/demo deployment. For production, point
# this at Postgres, e.g.: postgresql+psycopg2://user:pass@host:5432/freight
DATABASE_URL=sqlite:///adaptive_freight.db
REDIS_URL=

# --- Security (REQUIRED for any non-localhost deployment) ---
# Comma-separated key:role pairs. Roles: readonly, dispatcher, admin.
# If left empty, every endpoint is UNAUTHENTICATED — fine for python run.py
# on your own laptop, never for anything reachable over a network.
API_KEYS=
# Comma-separated list of browser origins allowed to call this API from
# outside the dashboard it serves itself, e.g. https://ops.yourcompany.com
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=300

# --- Simulation vs. production data ---
DEMO_ORDER_STREAM=true
LIVE_ORDER_STREAM=true
LIVE_ORDER_INTERVAL_S=25
SIM_MINUTES_PER_SECOND=2.0
ENGINE_TICK_MS=200
MAX_ORDERS_PER_TICK=50
CHECKPOINT_INTERVAL_S=10
LOG_JSON=false
